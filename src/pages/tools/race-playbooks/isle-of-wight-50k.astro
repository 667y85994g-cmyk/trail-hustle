---
import fs from "node:fs";
import path from "node:path";
import Layout from "../../../layouts/Layout.astro";
import ToolHeader from "../../../components/ToolHeader.astro";
import Footer from "../../../components/Footer.astro";
import Topography from "../../../components/Topography.astro";

const GPX_PATH = "/routes/isle-of-wight-50k.gpx";
const PLANNER_LINK = "/tools/fuel-planner?route=isle-of-wight-50k";

// The watch measured 55.0 km; the thinned route file measures slightly less. Stops are placed proportionally.
const RACE_KM = 55.0;

const gpx = fs.readFileSync(path.join(process.cwd(), "public", GPX_PATH), "utf8");
const raw = [...gpx.matchAll(/<trkpt lat="([-\d.]+)" lon="([-\d.]+)"><ele>([-\d.]+)<\/ele>/g)].map((m) => ({
  lat: +m[1],
  lon: +m[2],
  ele: +m[3],
}));
const rad = Math.PI / 180;
let along = 0;
const profile = raw.map((p, i) => {
  if (i > 0) {
    const q = raw[i - 1];
    const h =
      Math.sin(((p.lat - q.lat) * rad) / 2) ** 2 +
      Math.cos(q.lat * rad) * Math.cos(p.lat * rad) * Math.sin(((p.lon - q.lon) * rad) / 2) ** 2;
    along += 6371 * 2 * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
  }
  return { km: along, ele: p.ele };
});
const routeKm = along;

const W = 1000;
const H = 220;
const PAD = { top: 16, bottom: 28, left: 0, right: 0 };
const maxEle = Math.ceil(Math.max(...profile.map((p) => p.ele)) / 50) * 50;
const x = (km: number) => PAD.left + (km / routeKm) * (W - PAD.left - PAD.right);
const y = (ele: number) => PAD.top + (1 - Math.max(ele, 0) / maxEle) * (H - PAD.top - PAD.bottom);
const step = Math.max(1, Math.floor(profile.length / 400));
const sampled = profile.filter((_, i) => i % step === 0).concat(profile[profile.length - 1]);
const line = sampled.map((p, i) => `${i ? "L" : "M"}${x(p.km).toFixed(1)},${y(p.ele).toFixed(1)}`).join(" ");
const area = `${line} L${x(routeKm).toFixed(1)},${H - PAD.bottom} L${x(0).toFixed(1)},${H - PAD.bottom} Z`;
const highest = profile.reduce((a, b) => (b.ele > a.ele ? b : a));

// From the race write-up: stationary gaps over 90 seconds, clustered by where they happened.
const stops = [
  { km: 4.4, where: "4.4 km", elapsed: "0:30", minutes: 1.8 },
  { km: 10.6, where: "10.6 km", elapsed: "1:18", minutes: 4.1 },
  { km: 14.0, where: "14.0 km", elapsed: "1:48", minutes: 3.4 },
  { km: 18.9, where: "18.6–19.3 km", elapsed: "2:24–2:36", minutes: 5.5 },
  { km: 26.4, where: "26.4 km, halfway", elapsed: "3:36–3:42", minutes: 10.5 },
  { km: 34.4, where: "34.4 km", elapsed: "4:48", minutes: 4.8 },
  { km: 45.2, where: "42.5, 45.2 and 48.3 km", elapsed: "6:00–6:54", minutes: 9.9 },
];
const stopX = (km: number) => x((km / RACE_KM) * routeKm);
const kmTicks = [0, 10, 20, 30, 40, 50];

const figures = [
  { value: "55.0 km", label: "measured, 50 on the entry form" },
  { value: "864 m", label: "of climbing" },
  { value: "7 h 46", label: "start to finish" },
  { value: "14°C", label: "light wind, barely any rain" },
];
---

<Layout
  title="Isle of Wight 50 km ultra — Race playbook — Trail Hustle"
  description="Fifty kilometres across the Isle of Wight, south to north. What the day was like, what I carried, where the time went, and the route to plan your own."
  variant="tool"
  noindex
>
  <ToolHeader current="tools" />
  <main>
    <section class="hero relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <Topography stroke="#D9D3C8" opacity={0.6} preserveAspectRatio="xMidYMid slice" class="h-full w-full" />
      </div>
      <div class="relative mx-auto max-w-5xl px-6 pb-24 pt-24 sm:pt-32">
        <p class="eyebrow">Race playbook · Isle of Wight · 2 May 2026</p>
        <h1 class="mt-5 font-display text-[clamp(48px,8vw,104px)] leading-[0.98] tracking-tight text-ink">
          Across the island<span class="text-th-burnt-ochre">.</span>
        </h1>
        <p class="lede mt-8">
          Fifty kilometres on the entry form, fifty-five on my watch, from the south of the Isle of
          Wight to the north. This is the race as I found it, and what I'd want to know if I were
          standing at the start.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-20 sm:py-28" aria-label="The long middle">
      <blockquote class="pull">
        <p>
          Somewhere around the middle there's a stretch every ultra has and almost no one describes
          honestly. The novelty is gone. The legs have gone. The view has stopped being a view.
          Whatever you came out for is no longer present. You are still hours from the line.
        </p>
      </blockquote>
      <div class="prose-th mx-auto mt-12 max-w-[60ch]">
        <p>
          What got me through the long middle was not a view. Not a song. Not a finish line.
        </p>
        <p class="text-ink">
          It was the people next to me doing the same hours.
        </p>
        <p class="source">From The Log, the week after.</p>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-20" aria-labelledby="morning-heading">
      <h2 id="morning-heading" class="section-heading">Before the start</h2>
      <div class="prose-th mt-6 max-w-[60ch]">
        <p>Eight o'clock. Fourteen degrees, a light wind and barely any rain.</p>
      </div>
      <p class="gap-note">
        For Ben: one moment from the morning, in your words. What you saw, who was around you, how it
        felt to be standing there. Two or three sentences.
      </p>
    </section>

    <section class="carried border-y border-rule" aria-labelledby="carried-heading">
      <div class="mx-auto grid max-w-5xl gap-12 px-6 py-20 md:grid-cols-[1.2fr_1fr] md:items-end">
        <div>
          <h2 id="carried-heading" class="section-heading">What I carried</h2>
          <div class="prose-th mt-6 max-w-[56ch]">
            <p>
              I planned the fuelling in the Fuel Planner that week: eleven gels, four bars and three
              bottles of drink mix, about 64 grams of carbohydrate an hour, laid out against the route
              so I knew what was coming before it came.
            </p>
            <p>
              Nothing ran out. Where I lost time, it was standing still, not running dry.
            </p>
          </div>
        </div>
        <div class="carried-cta">
          <p class="font-display text-[22px] leading-snug text-ink">The same planner, with this course already loaded.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={PLANNER_LINK} class="pill pill-primary">
              Plan your fuelling
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7 L11 7 M7 3 L11 7 L7 11" /></svg>
            </a>
            <a href={GPX_PATH} download="isle-of-wight-50k.gpx" class="pill pill-outline">Download the route</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-6 py-20" aria-labelledby="profile-heading">
      <h2 id="profile-heading" class="section-heading">The shape of the day</h2>
      <p class="mt-4 max-w-[60ch] text-[16px] leading-relaxed text-ink-mute">
        Short climbs rather than one big hill. The highest point is only {Math.round(highest.ele)} m,
        about {Math.round(highest.km)} km in. The orange marks are where I stopped, and the bigger the
        mark, the longer I stood there.
      </p>
      <figure class="mt-10">
        <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Elevation profile of the route with stops marked">
          <line x1="0" x2={W} y1={H - PAD.bottom} y2={H - PAD.bottom} stroke="#D9D3C8" stroke-width="1" />
          <path d={area} fill="#111111" fill-opacity="0.05" />
          <path d={line} fill="none" stroke="#111111" stroke-width="1.5" stroke-linejoin="round" />
          {
            stops.map((s) => (
              <g>
                <title>{`${s.where}, ${s.elapsed} in: stopped ${s.minutes} min`}</title>
                <line x1={stopX(s.km)} x2={stopX(s.km)} y1={PAD.top} y2={H - PAD.bottom} stroke="#D15839" stroke-width="1" stroke-dasharray="3 3" stroke-opacity="0.5" />
                <circle cx={stopX(s.km)} cy={PAD.top + 4} r={3 + s.minutes * 0.6} fill="#D15839" fill-opacity="0.85" />
              </g>
            ))
          }
          {
            kmTicks.map((k) => (
              <text x={stopX(k)} y={H - 8} font-size="12" fill="#8C877E" text-anchor={k === 0 ? "start" : "middle"} font-family="Inter, sans-serif">{k} km</text>
            ))
          }
        </svg>
      </figure>
      <dl class="figures">
        {
          figures.map((f) => (
            <div>
              <dt class="sr-only">{f.label}</dt>
              <dd>
                <span class="figure-value">{f.value}</span>
                <span class="figure-label">{f.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mx-auto max-w-5xl px-6 pb-20" aria-labelledby="going-heading">
      <h2 id="going-heading" class="section-heading">If you're going</h2>
      <div class="mt-8 grid gap-12 md:grid-cols-2">
        <div class="prose-th">
          <h3>The ground</h3>
          <p>
            I walked anything steep, on purpose. About four hours of the day is gentler ground, and that's where a steady rhythm matters most.
          </p>
          <p>
            The downhills surprised me. I was slower going down than on the flat, which is time given
            away for nothing. If you're happy descending, this course will pay you for it.
          </p>
        </div>
        <div class="prose-th">
          <h3>Where the time went</h3>
          <p>
            My plan had five aid stations. I stopped fifteen times, 39 minutes in all, and ten and a
            half of those were at halfway. At my steady pace that's about five kilometres of course.
          </p>
          <p>
            I didn't note which stops were checkpoints and which were gates and stiles. Next time I
            will.
          </p>
          <details class="stops">
            <summary>Every stop</summary>
            <table class="stops-table">
              <thead>
                <tr><th scope="col">Where</th><th scope="col">Time in</th><th scope="col">Stopped</th></tr>
              </thead>
              <tbody>
                {
                  stops.map((s) => (
                    <tr>
                      <td>{s.where}</td>
                      <td>{s.elapsed}</td>
                      <td>{s.minutes} min</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </details>
        </div>
      </div>
    </section>

    <section class="closing relative overflow-hidden border-t border-rule">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <Topography stroke="#D9D3C8" opacity={0.45} preserveAspectRatio="xMidYMid slice" class="h-full w-full" />
      </div>
      <div class="relative mx-auto max-w-5xl px-6 py-24">
        <p class="closing-line">
          If you're running it next May, decide before the start which stops you'll stop at<span class="text-th-burnt-ochre">.</span>
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href={PLANNER_LINK} class="pill pill-primary">Plan your fuelling</a>
          <a href={GPX_PATH} download="isle-of-wight-50k.gpx" class="pill pill-outline">Download the route</a>
        </div>

        <aside class="prototype-note" aria-label="Prototype notes">
          <p class="font-display text-[16px] text-ink">Prototype: to confirm before publishing</p>
          <ul>
            <li>Your moment from the morning, above.</li>
            <li>Organiser, official event name and the 2027 date.</li>
            <li>Start and finish: place names, parking and postcode, and how people get back to the start.</li>
            <li>Which stops were official checkpoints, and what they stocked.</li>
            <li>One photograph from the course.</li>
          </ul>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-mute);
    margin: 0;
  }

  .lede {
    max-width: 54ch;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--color-ink-mute);
  }

  .pull {
    margin: 0 auto;
    max-width: 30ch;
    font-family: var(--font-display);
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-align: center;
  }

  .pull p {
    margin: 0;
  }

  .source {
    font-size: 14px;
    color: var(--color-ink-faint);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  .prose-th {
    color: var(--color-ink-mute);
    font-size: 17px;
    line-height: 1.7;
  }

  .prose-th p {
    margin: 0 0 14px;
  }

  .prose-th h3 {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-ink);
    margin: 0 0 10px;
  }

  .gap-note {
    margin-top: 20px;
    max-width: 60ch;
    border: 1px dashed var(--color-th-burnt-ochre);
    border-radius: 14px;
    padding: 14px 18px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-th-clay-red);
  }

  .carried {
    background: var(--color-paper-edge);
  }

  .figures {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (min-width: 768px) {
    .figures {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .figures dd {
    margin: 0;
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
  }

  .figure-value {
    display: block;
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--color-ink);
  }

  .figure-label {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    color: var(--color-ink-faint);
  }

  .stops {
    margin-top: 8px;
  }

  .stops summary {
    cursor: pointer;
    font-size: 15px;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 4px;
  }

  .stops-table {
    margin-top: 16px;
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  .stops-table th {
    text-align: left;
    font-weight: 500;
    color: var(--color-ink-faint);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 0 8px;
    border-bottom: 1px solid var(--color-ink);
  }

  .stops-table td {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
  }

  .closing-line {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 12px 22px;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .pill-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .pill-primary:hover,
  .pill-primary:focus-visible {
    background: var(--color-th-burnt-ochre);
  }

  .pill-outline {
    border: 1px solid var(--color-ink);
    color: var(--color-ink);
  }

  .pill-outline:hover,
  .pill-outline:focus-visible {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .prototype-note {
    margin-top: 64px;
    max-width: 60ch;
    border: 1px dashed var(--color-th-burnt-ochre);
    border-radius: 16px;
    padding: 20px 24px;
    background: var(--color-paper);
    color: var(--color-ink-mute);
    font-size: 14px;
    line-height: 1.6;
  }

  .prototype-note ul {
    margin: 8px 0 0;
    padding-left: 1.1rem;
    list-style: disc;
  }
</style>
